generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String
  fullName       String
  pronouns       String   @default("")
  bio            String   @default("")
  website        String   @default("")
  avatarUrl      String   @default("")
  isVerified     Boolean  @default(false)
  isPrivate      Boolean  @default(false)
  isProfessional Boolean  @default(false)
  proCategory    String   @default("Digital creator")
  gender         String   @default("Prefer not to say")
  dob            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts          Post[]
  stories        Story[]
  notes          Note?
  likes          Like[]
  comments       Comment[]
  savedPosts     SavedPost[]
  followers      Follow[]       @relation("following")
  following      Follow[]       @relation("follower")
  sentMessages   Message[]      @relation("sender")
  conversationsA Conversation[] @relation("userA")
  conversationsB Conversation[] @relation("userB")
  notifications  Notification[] @relation("recipient")
  actedNotifs    Notification[] @relation("actor")
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption     String   @default("")
  location    String   @default("")
  mediaUrls   String[]
  mediaType   String   @default("IMAGE")
  filter      String   @default("")
  audioName   String   @default("")
  ratio       String   @default("4/5")
  isPinned    Boolean  @default(false)
  hideLikes   Boolean  @default(false)
  commentsOff Boolean  @default(false)
  createdAt   DateTime @default(now())

  likes       Like[]
  comments    Comment[]
  savedBy     SavedPost[]
}

model Story {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl       String
  mediaType      String   @default("IMAGE")
  stickersJson   String   @default("[]")
  isCloseFriends Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

model Note {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  musicTitle  String   @default("")
  musicArtist String   @default("")
  location    String   @default("")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  parentId  String?
  text      String
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
}

model SavedPost {
  id         String   @id @default(cuid())
  userId     String
  postId     String
  collection String   @default("All Posts")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  status      String   @default("ACCEPTED")
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  theme     String    @default("Classic Black")
  vanish    Boolean   @default(false)
  updatedAt DateTime  @updatedAt

  userA     User      @relation("userA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("userB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String       @default("")
  mediaUrl       String       @default("")
  mediaType      String       @default("")
  voiceDuration  Int          @default(0)
  sharedReelId   String?
  replyToText    String       @default("")
  reaction       String       @default("")
  isVanish       Boolean      @default(false)
  seenAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String
  type        String
  postId      String?
  commentId   String?
  text        String   @default("")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
}
